<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }} | {{ site.tagline }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:title" content="{{ title or site.name }}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}" />
    <meta property="og:image" content="{{ (socialImage or '/assets/img/brand/lynk-logo.png') | absoluteUrl(site.url) }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#BF5700" />

    <link rel="icon" href="/assets/img/brand/lynk-logo.png" />
    <link rel="apple-touch-icon" href="/assets/img/brand/lynk-logo.png" />

    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/redhatdisplay-latin.woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/site.css" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SportsTeam",
        "name": "LYNK Robotics",
        "alternateName": "FRC Team 9496",
        "url": "{{ site.url }}",
        "sport": "FIRST Robotics Competition",
        "email": "{{ site.contact.email }}",
        "parentOrganization": {
          "@type": "NGO",
          "name": "{{ site.parentOrg.name }}",
          "url": "{{ site.parentOrg.url }}"
        },
        "sameAs": [{% for s in site.social %}"{{ s.url }}"{% if not loop.last %}, {% endif %}{% endfor %}]
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    {% include "partials/header.njk" %}

    <main id="main">{{ content | safe }}</main>

    {% include "partials/footer.njk" %}

    <script src="/assets/js/site.js" defer></script>
  </body>
</html>
